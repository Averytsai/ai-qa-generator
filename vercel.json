{
  "buildCommand": "cd api && npm install --legacy-peer-deps && cd ../frontend && npm install && npm run build",
  "outputDirectory": "frontend/dist",
  "installCommand": "cd api && npm install --legacy-peer-deps && cd ../frontend && npm install",
  "functions": {
    "api/**/*.ts": {
      "includeFiles": "api/node_modules/**"
    },
    "api/**/*.js": {
      "includeFiles": "api/node_modules/**"
    }
  },
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api/$1"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ]
}
